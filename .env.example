# ==============================================================================
# COURTLY ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# API Configuration
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# Database (Neon PostgreSQL & Prisma ORM 7)
# Pooled connection URL for runtime application queries
DATABASE_URL=postgresql://neondb_owner:<password>@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection URL for Prisma CLI migration operations
DIRECT_URL=postgresql://neondb_owner:<password>@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis Cache & Throttler
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Email Delivery (Resend)
# Leave blank in development to use the terminal logger fallback
RESEND_API_KEY=
EMAIL_FROM=Courtly <onboarding@resend.dev>

# Deep Link Scheme for Mobile
APP_DEEP_LINK_SCHEME=courtly

# Cloudinary Image Storage (Backend-only signed uploads — NEVER expose secret to mobile)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protected Initial Admin Bootstrap (Used ONLY by `pnpm --filter @courtly/api db:seed`)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Courtly Admin

# Mobile Public URL (set to your computer's local Wi-Fi IP for physical device testing)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Optional MapLibre Vector Style URL override (defaults to OpenFreeMap dark style — NO API key required)
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
