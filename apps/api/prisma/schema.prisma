datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Role {
  PLAYER
  VENUE_OWNER
  ADMIN
}

enum Sport {
  FOOTBALL
  CRICKET
  BADMINTON
  TENNIS
  BASKETBALL
  PADEL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OwnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VenueStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
}

enum CourtStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  phoneNumber      String?
  avatarUrl        String?
  status           UserStatus   @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  roles                   UserRole[]
  profile                 PlayerProfile?
  sportSkills             PlayerSportSkill[]
  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  ownerApplications       OwnerApplication[]       @relation("UserOwnerApplications")
  reviewedApplications    OwnerApplication[]       @relation("AdminReviewedApplications")
  ownedVenues             Venue[]                  @relation("OwnedVenues")
  reviewedVenues          Venue[]                  @relation("AdminReviewedVenues")
  adminAuditLogs          AdminAuditLog[]          @relation("AdminAuditLogs")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model PlayerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  city            String?
  state           String?
  country         String?
  preferredSports Sport[]  @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

model PlayerSportSkill {
  id         String     @id @default(uuid())
  userId     String
  sport      Sport
  skillLevel SkillLevel @default(BEGINNER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sport])
  @@index([userId])
  @@map("player_sport_skills")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  deviceName String?
  platform   String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("user_sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  sessionId         String
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model OwnerApplication {
  id                    String                 @id @default(uuid())
  userId                String
  businessName          String
  businessType          String
  contactPerson         String
  contactPhone          String
  city                  String
  state                 String
  country               String
  additionalInformation String                 @default("")
  status                OwnerApplicationStatus @default(PENDING)
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user       User  @relation("UserOwnerApplications", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AdminReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("owner_applications")
}

model Venue {
  id                   String      @id @default(uuid())
  ownerId              String
  name                 String
  slug                 String      @unique
  description          String      @default("")
  businessContactPhone String      @default("")
  businessContactEmail String      @default("")
  addressLine1         String      @default("")
  addressLine2         String?
  locality             String      @default("")
  city                 String      @default("")
  state                String      @default("")
  postalCode           String      @default("")
  country              String      @default("India")
  latitude             Decimal?    @db.Decimal(9, 6)
  longitude            Decimal?    @db.Decimal(9, 6)
  timezone             String      @default("Asia/Kolkata")
  currency             String      @default("INR")
  status               VenueStatus @default(DRAFT)
  rejectionReason      String?
  reviewedById         String?
  reviewedAt           DateTime?
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  owner      User           @relation("OwnedVenues", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy User?          @relation("AdminReviewedVenues", fields: [reviewedById], references: [id], onDelete: SetNull)
  courts     Court[]
  amenities  VenueAmenity[]
  images     VenueImage[]

  @@index([ownerId])
  @@index([status])
  @@index([city, status])
  @@index([status, state])
  @@index([status, archivedAt])
  @@index([status, latitude, longitude])
  @@map("venues")
}

model Court {
  id               String      @id @default(uuid())
  venueId          String
  name             String
  sport            Sport
  description      String?
  surfaceType      String?
  indoor           Boolean     @default(false)
  maxPlayers       Int
  basePricePerHour Decimal     @db.Decimal(10, 2)
  currency         String      @default("INR")
  status           CourtStatus @default(ACTIVE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, status])
  @@index([venueId, status, sport])
  @@index([venueId, status, basePricePerHour])
  @@index([venueId, status, indoor])
  @@index([sport, status])
  @@index([basePricePerHour])
  @@map("courts")
}

model Amenity {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  category  String
  icon      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues VenueAmenity[]

  @@index([isActive])
  @@map("amenities")
}

model VenueAmenity {
  venueId   String
  amenityId String
  createdAt DateTime @default(now())

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([venueId, amenityId])
  @@index([venueId])
  @@index([amenityId])
  @@map("venue_amenities")
}

model VenueImage {
  id        String   @id @default(uuid())
  venueId   String
  publicId  String   @unique
  secureUrl String
  width     Int
  height    Int
  format    String
  bytes     Int
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, position])
  @@map("venue_images")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  entityType String
  entityId   String
  action     String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
